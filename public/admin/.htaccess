Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
</IfModule>

# Block direct web access to data files (config/leads)
<FilesMatch "^(config|leads)\.json$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
